<?xml version="1.0" encoding="UTF-8"?>
 
 <?import javafx.scene.control.Label?>
 <?import javafx.scene.control.TabPane?>
 <?import javafx.scene.layout.BorderPane?>
 <?import javafx.scene.layout.HBox?>
 <BorderPane xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1"
             fx:controller="net.hero.editor.oreo.controller.EditorController">
     <center>
        <TabPane fx:id="tabPane" BorderPane.alignment="CENTER" tabClosingPolicy="ALL_TABS"/>
     </center>
     <bottom>
        <HBox fx:id="footer" alignment="CENTER_LEFT" spacing="0"
              style="-fx-padding: 2 5 2 5; -fx-background-color: #f0f0f0; -fx-border-color: #ccc; -fx-border-width: 1 0 0 0;">
        </HBox>
    </bottom>
</BorderPane>
